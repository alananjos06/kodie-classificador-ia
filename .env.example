# Copie este arquivo para .env e preencha. NUNCA suba o .env para o GitHub.

# Provedor de IA: gemini | groq | openai | mock (mock = sem IA, só para testes)
LLM_PROVIDER=gemini

# Sua chave de API (Gemini: https://aistudio.google.com/apikey)
LLM_API_KEY=

# Opcional: troque o modelo ou o endereço (deixe vazio para usar o padrão do provedor)
LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=

# Abaixo deste valor de confiança (0 a 1) a mensagem vai para revisão humana
LIMITE_CONFIANCA=0.6

# Quantas vezes tentar de novo se a IA devolver um JSON inválido
MAX_TENTATIVAS=2